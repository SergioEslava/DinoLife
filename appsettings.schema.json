{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DinoLife App Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rendererDefault",
    "targetFrameMs",
    "autosaveEveryTicks",
    "hotReloadEnabled",
    "saveDirectory",
    "tuningDirectory"
  ],
  "properties": {
    "rendererDefault": {
      "type": "string",
      "enum": [
        "legacy",
        "tui"
      ]
    },
    "targetFrameMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "autosaveEveryTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "hotReloadEnabled": {
      "type": "boolean"
    },
    "saveDirectory": {
      "type": "string",
      "minLength": 1
    },
    "tuningDirectory": {
      "type": "string",
      "minLength": 1
    }
  }
}
